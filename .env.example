# Cloudflare API Token — needs Zone:DNS:Edit permission for your zone
# Create at: Cloudflare Dashboard → Profile → API Tokens → Edit zone DNS template
CF_DNS_API_TOKEN=your_cloudflare_token_here

# Your base domain (GTM containers will be at *.BASE_DOMAIN)
BASE_DOMAIN=yourdomain.com

# Email for Let's Encrypt registration
ACME_EMAIL=admin@yourdomain.com

# Traefik dashboard basic auth
# Generate on your Linux VM with: htpasswd -nb admin yourpassword
# Then escape every $ as $$ below
TRAEFIK_DASHBOARD_AUTH=admin:$$apr1$$replace$$withyourhash
